{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {},
  "license": "${license}",
  "icon": "assets/weightchallenge/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.jason54.weightchallenge.WeightChallengeFabric"
    ],
    "client": [
      "com.jason54.weightchallenge.WeightChallengeFabricClient"
    ]
  },
  "mixins": [
    "weightchallenge.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
